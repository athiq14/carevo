# AI Career Intelligence Agent - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.

# Application Settings
APP_ENV=development
APP_DEBUG=true

# AI Provider Settings
# Gemini API Key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
# Configurable Gemini Model (candidate: gemini-3.8-flash; alternative: gemini-2.5-flash)
GEMINI_MODEL=gemini-3.8-flash

# Groq API Settings (https://console.groq.com/)
GROQ_API_KEY=
# Configurable Groq Model (recommended production: openai/gpt-oss-120b; alternative: llama-3.1-8b-instant)
GROQ_MODEL=openai/gpt-oss-120b

# Storage / Database (SQLite)
DATABASE_URL=sqlite:///./career_intelligence.db

